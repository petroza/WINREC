<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>WINREC</AssemblyName>
    <RootNamespace>WINREC</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <Version>2.0.0</Version>
    <Product>WINREC</Product>
    <Company>Petr Závorka</Company>
    <Copyright>© Petr Závorka 2026</Copyright>
    <Description>WINREC — nahrávání obrazovky pro Windows</Description>

    <!-- Samostatná aplikace: na cílovém PC není potřeba instalovat .NET -->
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>cs;en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ScreenRecorderLib" Version="7.0.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\icon.ico" />
  </ItemGroup>

  <!-- VC++ runtime (potřebuje ScreenRecorderLib) přibalený vedle exe, aby WINREC běžel i bez nainstalovaného
       VC++ Redistributable. Bere se při sestavení ze systému, proto není v repozitáři. -->
  <PropertyGroup>
    <VcDir>$(SystemRoot)\System32</VcDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(VcDir)\concrt140.dll" Link="concrt140.dll" Condition="Exists('$(VcDir)\concrt140.dll')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(VcDir)\msvcp140.dll" Link="msvcp140.dll" Condition="Exists('$(VcDir)\msvcp140.dll')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(VcDir)\vcruntime140.dll" Link="vcruntime140.dll" Condition="Exists('$(VcDir)\vcruntime140.dll')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(VcDir)\vcruntime140_1.dll" Link="vcruntime140_1.dll" Condition="Exists('$(VcDir)\vcruntime140_1.dll')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
